{
  "name": "tmdb-player",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A private, modern cinema web app built on TMDB metadata, multi-server streaming, and Cloudflare Workers + D1.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.3.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.16.0"
  },
  "license": "MIT"
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmdb-player",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

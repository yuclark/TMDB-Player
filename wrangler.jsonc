{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmdb-player",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-27",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tmdb-player-db",
      "database_id": "918a9c0a-7519-46a1-8fa1-d69f24203bd3"
    }
  ]
}
